OPENAI_API_KEY=sk-...
# Same engine family as ChatGPT Images 2.5. Use gpt-image-2.5-flare for faster, cheaper drafts.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Used automatically if your key cannot access the model above
OPENAI_FALLBACK_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=https://fabricnow.tonasel.com
# Optional: require this token for generation (users are prompted once)
ACCESS_TOKEN=
RATE_LIMIT_PER_HOUR=20
MAX_UPLOAD_MB=10
MAX_CONCURRENT_JOBS=3
RETENTION_HOURS=72
DATA_DIR=/data
ENV=production
# Vision model that determines garment type and numeric pattern geometry. Final SVG/PNG geometry is rendered deterministically.
OPENAI_VISION_MODEL=gpt-4.1
# Redraw once if the layout is clipped or pieces are missing (each attempt is billed)
MAX_ATTEMPTS=2

# AI vision provider: auto, openai, or claude. Claude is used when configured in auto.
AI_VISION_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

# Deterministic pattern renderer scale. 2 px per inferred millimetre.
PATTERN_PX_PER_MM=2
